# Use the MSW mocks instead of the real backends (dev only).
VITE_ENABLE_MOCKS=false
# Empty in local dev: requests go through the Vite proxy (see vite.config.ts).
VITE_API_BASE_URL=
# Application id of "Vivos" in darmoz-auth (sent as the API_ID header).
VITE_API_ID=22222222-2222-2222-2222-222222222222
# How often the session is refreshed while the admin is open (min 60000).
VITE_TOKEN_REFRESH_INTERVAL_MS=300000

# Dev server proxy targets (not exposed to the browser).
DEV_AUTH_TARGET=http://localhost:8080
DEV_VIVOS_TARGET=http://localhost:8082
